{
  "name": "webhook-processor-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable webhook processor: NestJS API + PostgreSQL-backed workers",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "migrate": "node dist/migrate.js",
    "dev:api": "ts-node src/main.ts",
    "dev:worker": "ts-node src/main.worker.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "testTimeout": 60000
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.12",
    "@nestjs/platform-express": "^11.2.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "kysely": "^0.29.9",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
