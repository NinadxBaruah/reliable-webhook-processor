# Optional. Copy to .env to override the defaults used by docker-compose.yml.

# Host ports
API_HOST_PORT=3000
FRONTEND_HOST_PORT=3001
POSTGRES_HOST_PORT=55432

# Retry policy
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=30000

# Leases: a worker owns an event for LEASE_MS and renews it every HEARTBEAT_MS.
# HEARTBEAT_MS must be at most half of LEASE_MS.
LEASE_MS=10000
HEARTBEAT_MS=3000
RECOVERY_INTERVAL_MS=2000

# Events each worker container processes at the same time
WORKER_CONCURRENCY=4

LOG_LEVEL=info
